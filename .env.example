# ============================================================================
# TRACE-X environment template
# Copy to .env and adjust. `.env` is gitignored and must NEVER be committed.
#
# BOOTSTRAP GUARANTEE: every value below has a working local default.
# No AWS, Databricks, or paid LLM access is required to run `make up`/`make demo`.
# ============================================================================

TRACE_ENV=local
TRACE_LOG_LEVEL=INFO
TRACE_LOG_FORMAT=json                 # json | console

# --- Process topology -------------------------------------------------------
# 1 = collapse gateway+api into one process (laptop dev). 0 = split (compose.full/k8s).
TRACE_SINGLE_PROCESS=1

# --- Ports (chosen to avoid collisions with other local projects) -----------
TRACE_GATEWAY_PORT=8010
TRACE_API_PORT=8011
TRACE_UI_PORT=3010
POSTGRES_PORT=5442
REDIS_CACHE_PORT=6390
REDIS_PORT=6389
KAFKA_PORT=9092
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
MLFLOW_PORT=5010
PROMETHEUS_PORT=9090
GRAFANA_PORT=3011
JAEGER_UI_PORT=16686
OTLP_GRPC_PORT=4317
OLLAMA_PORT=11434

# --- Postgres ---------------------------------------------------------------
# Five schemas with distinct roles. See docs/SECURITY.md and ADR-0004.
POSTGRES_DB=tracex
POSTGRES_HOST=localhost
POSTGRES_SUPERUSER=tracex_owner
POSTGRES_SUPERUSER_PASSWORD=change_me_locally

# Application role: NO GRANT on the `groundtruth` schema. This is enforced by
# migration and asserted by a release-blocking test.
TRACE_APP_DB_USER=trace_app
TRACE_APP_DB_PASSWORD=change_me_locally

# Evaluation role: the ONLY role permitted to read ground truth.
TRACE_EVAL_DB_USER=trace_eval
TRACE_EVAL_DB_PASSWORD=change_me_locally

# Streaming (Spark) role: read-only on the app schema.
TRACE_STREAM_DB_USER=trace_stream
TRACE_STREAM_DB_PASSWORD=change_me_locally

# Auditor role: read-only, including the audit schema. No groundtruth access.
TRACE_AUDITOR_DB_USER=trace_auditor
TRACE_AUDITOR_DB_PASSWORD=change_me_locally

# The generator writes ground truth and CANNOT read it back (ADR-0031).
# INSERT on the label tables, SELECT only on the dataset registry.
TRACE_GENERATOR_DB_PASSWORD=change_me_locally

# --- Redis ------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_DB=0

# --- Service tokens (docs/SECURITY.md §3, Plane B) ---------------------------
# TRACE_SERVICE_TOKEN_<ID>=<secret>. A caller presents `Bearer <id>.<secret>`,
# with the id lowercased -- so this one is presented as `local.<secret>`.
# The gateway REFUSES TO START with none configured: authenticating a built-in
# credential would be open by default, and open by default fails silently.
# Minimum 32 characters. Replace before anything but local use:
#   openssl rand -hex 32
TRACE_SERVICE_TOKEN_LOCAL=local_dev_token_change_me_before_use_32

# --- Gateway rate limiting ---------------------------------------------------
# PER SERVICE TOKEN, per window. The ROADMAP's Phase 2 load target is 500 TPS
# sustained through one token, so the default must exceed 500 * 60 = 30,000 or a
# load run measures the 429 path instead of the scoring path -- the limiter would
# be exhausted about two seconds in. Set well above the target rather than at it,
# so a burst does not clip the measurement.
TRACE_RATE_LIMIT_PER_MINUTE=60000
TRACE_RATE_LIMIT_WINDOW_S=60
# The gateway's observation-log broker (ADR-0051), on the compose network's internal listener.
# Empty: nothing is published and no writer session closes; scoring is unaffected. With
# `--profile streaming`, set it to kafka:19092.
TRACE_GATEWAY_KAFKA_BOOTSTRAP=
# Experiment-only: the relay on a gateway thread (ADR-0051 §7, option A), kept for the A/B's
# `log-relay` arm. The A/B ruled it out: the relay runs in trace-worker. Leave it false.
TRACE_GATEWAY_OUTBOX_RELAY=false
# trace-worker's broker, for the outbox relay (ADR-0051 §7, option B). Compose sets kafka:19092 for
# the `worker` service; set this only when running `python -m services.worker` on the host.
TRACE_WORKER_KAFKA_BOOTSTRAP=localhost:9092

# --- LLM provider tiers (ADR-0016) ------------------------------------------
# SMOKE = local Ollama, no key required, DEFAULT for a bare clone.
# DEV   = OpenAI-compatible endpoint using your own key.
# EVAL  = AWS Bedrock. The ONLY tier whose numbers may be published as quality results.
# CI    = cassette replay of previously recorded real traffic.
TRACE_LLM_TIER=SMOKE
TRACE_LLM_MODEL_SMOKE=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434/v1

# DEV tier (optional)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# TRACE_LLM_MODEL_DEV=

# EVAL tier (optional; Phase 12)
# AWS_REGION=us-east-1
# TRACE_LLM_MODEL_EVAL=
# TRACE_BEDROCK_GUARDRAIL_ID=

# --- Investigation budgets (§12; four independent termination bounds) -------
TRACE_MAX_STEPS=30
TRACE_MAX_WALLCLOCK_S=120
TRACE_MAX_COST_USD=0.25

# --- MCP transport (ADR-0013) -----------------------------------------------
# stdio = default, zero container cost. http = streamable HTTP + OAuth 2.1.
TRACE_MCP_TRANSPORT=stdio

# --- Spark / Delta (ADR-0018; asserted by `make doctor`) --------------------
# Must be Temurin 17 — Spark 4.0 does not support Java 25.
# JAVA_HOME=/Library/Java/JavaVirtualMachines/temurin-17.jdk/Contents/Home
TRACE_DELTA_ROOT=./data/lake

# --- Track B external dataset (Phase 4B) ------------------------------------
# Raw data is NEVER committed. `make fetch-external` downloads and verifies it.
TRACE_EXTERNAL_DATA_DIR=./data/external
# KAGGLE_USERNAME=
# KAGGLE_KEY=
